generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  TEACHER
  PARENT
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model Tenant {
  id        String       @id @default(cuid())
  slug      String       @unique
  name      String
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users User[]
  students Student[]
  dailyReports DailyReport[]
  attendances Attendance[]
  dailyMenus DailyMenu[]
  activityPosts ActivityPost[]

  @@map("tenants")
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  role         UserRole
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  children Student[] @relation("ParentStudents")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Student {
  id          String   @id @default(cuid())
  tenantId    String
  parentId    String?
  firstName   String
  lastName    String
  dateOfBirth DateTime
  gender      String?
  notes       String?
  passport    Json?    @default("{}")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent User?  @relation("ParentStudents", fields: [parentId], references: [id], onDelete: SetNull)

  dailyReports DailyReport[]
  attendances Attendance[]

  @@index([tenantId])
  @@index([tenantId, parentId])
  @@index([tenantId, deletedAt])
  @@map("students")
}

model DailyReport {
  id          String   @id @default(cuid())
  tenantId    String
  studentId   String
  date        DateTime @db.Date
  mood        String?
  meals       Json?    @default("{}")
  naps        Json?    @default("{}")
  potty       Json?    @default("[]")
  activities  Json?    @default("[]")
  medications Json?    @default("[]")
  teacherNote String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, studentId, date])
  @@index([tenantId, date])
  @@index([tenantId, studentId])
  @@map("daily_reports")
}

model Attendance {
  id              String   @id @default(cuid())
  tenantId        String
  studentId       String
  date            DateTime @db.Date
  status          String   @default("ABSENT") // PRESENT, ABSENT, EXCUSED, LEFT
  checkInTime     String?  // HH:mm
  checkInBy       String?
  checkOutTime    String?  // HH:mm
  checkOutBy      String?
  pickupContactId String?
  pickupNote      String?
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, studentId, date])
  @@index([tenantId, date])
  @@index([tenantId, studentId])
  @@map("attendances")
}

model DailyMenu {
  id        String   @id @default(cuid())
  tenantId  String
  date      DateTime @db.Date
  breakfast Json     @default("[]")
  lunch     Json     @default("[]")
  snack     Json     @default("[]")
  allergens Json     @default("[]")
  calories  Int?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@index([tenantId, date])
  @@map("daily_menus")
}

model ActivityPost {
  id               String    @id @default(cuid())
  tenantId         String
  authorId         String
  title            String
  description      String?
  classroom        String?
  activityDate     DateTime  @default(now())
  tags             Json      @default("[]")
  mediaUrls        Json      @default("[]")
  taggedStudentIds Json      @default("[]")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, activityDate])
  @@index([tenantId, classroom])
  @@map("activity_posts")
}

