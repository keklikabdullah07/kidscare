{
  "name": "kidscare",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @kidscare/database prisma migrate deploy",
    "db:migrate:dev": "pnpm --filter @kidscare/database prisma migrate dev",
    "db:seed": "pnpm --filter @kidscare/database prisma db seed",
    "db:reset": "pnpm --filter @kidscare/database prisma migrate reset --force",
    "dev:api": "pnpm --filter @kidscare/api start:dev",
    "dev:admin": "pnpm --filter @kidscare/admin-web dev",
    "dev:marketing": "pnpm --filter @kidscare/marketing dev",
    "dev:mobile": "pnpm --filter @kidscare/mobile exec expo start --clear",
    "dev:mobile:tunnel": "pnpm --filter @kidscare/mobile exec expo start --clear --tunnel",
    "test": "pnpm exec nx run-many --target=test",
    "test:integration": "pnpm --filter @kidscare/api test:integration",
    "lint": "pnpm exec nx run-many --target=lint",
    "format": "pnpm exec nx format:write",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@nx/eslint": "^19.0.0",
    "@nx/jest": "^19.8.14",
    "@nx/nest": "^19.0.0",
    "@nx/next": "^19.8.14",
    "@nx/node": "^19.8.14",
    "@nx/vite": "^19.8.14",
    "@nx/webpack": "^19.8.14",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/ui": "^5.0.0",
    "babel-preset-expo": "^57.0.11",
    "bcryptjs": "^3.0.3",
    "cpx2": "^9.0.3",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "expo": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "next": "^14.0.0",
    "nx": "^19.0.0",
    "prettier": "^3.9.6",
    "prisma": "^5.10.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "zod": "^3.22.0"
  }
}
